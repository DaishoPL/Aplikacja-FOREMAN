  <script>
    function openBrandEditor() {
      document.getElementById('brandEditor').classList.remove('hidden');
      document.getElementById('brandProjectName').focus();
    }

    function closeBrandEditor() {
      document.getElementById('brandEditor').classList.add('hidden');
      document.getElementById('brandEditorError').classList.add('hidden');
    }

    function saveBrandEditor(event) {
      event.preventDefault();
      const error = document.getElementById('brandEditorError');
      const saveButton = document.getElementById('brandEditorSave');
      error.classList.add('hidden');
      saveButton.disabled = true;
      saveButton.textContent = 'Zapisywanie...';

      const config = {
        projectName: document.getElementById('brandProjectName').value,
        country: document.getElementById('brandCountry').value,
        seaviaLogoUrl: document.getElementById('brandSeaviaLogoUrl').value,
        applicationLogoUrl: document.getElementById('brandApplicationLogoUrl').value,
        applicationLogoAlt: document.getElementById('brandApplicationLogoAlt').value,
        clientLogoUrl: document.getElementById('brandClientLogoUrl').value,
        clientLogoAlt: document.getElementById('brandClientLogoAlt').value
      };

      google.script.run
        .withSuccessHandler(() => window.location.reload())
        .withFailureHandler(message => {
          error.textContent = message && message.message ? message.message : 'Nie udało się zapisać ustawień.';
          error.classList.remove('hidden');
          saveButton.disabled = false;
          saveButton.textContent = 'Zapisz';
        })
        .saveBrandConfig(config);
    }

    function resetAllFormState() {
      if (typeof window !== 'undefined') {
        window.appData = null;
        window.initialData = null;
      }
      if (typeof currentTechSchedule !== 'undefined') {
        currentTechSchedule = [];
      }

      const formIds = [
        'assignTarget', 'workDate', 'timeStart', 'timeEnd', 'deckSelect', 'areaSelect',
        'roomSelect', 'customAreaInput', 'customRoomInput', 'taskSelect', 'customTaskInput',
        'customTaskIdInput', 'progressRange', 'taskRowNumber'
      ];
      formIds.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (el.tagName === 'SELECT') {
          el.value = '';
          el.selectedIndex = 0;
        } else if (el.type === 'range') {
          el.value = 0;
        } else {
          el.value = '';
        }
      });

      const customDeckInput = document.getElementById('customDeckInput');
      if (customDeckInput) customDeckInput.value = '';

      const scheduleSection = document.getElementById('scheduleSection');
      const scheduleList = document.getElementById('scheduleList');
      if (scheduleSection) scheduleSection.classList.add('hidden');
      if (scheduleList) scheduleList.innerHTML = '';

      const timeErrorMsg = document.getElementById('timeErrorMsg');
      if (timeErrorMsg) timeErrorMsg.classList.add('hidden');
      const submitBtn = document.getElementById('submitBtn');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'grayscale');
      }
    }

    function switchTab(tabId) {
      const tabs = ['project', 'tech', 'tasks', 'reports', 'koszty', 'timesheet', 'rooms', 'zip'];
      tabs.forEach(id => {
        const section = document.getElementById('sec-' + id);
        const btn = document.getElementById('btn-' + id);
        
        if (section && btn) {
          if (id === tabId) {
            section.classList.remove('hidden');
            section.classList.add('block');
            btn.className = "py-4 px-4 sm:px-6 text-seaviaBlue border-b-2 border-seaviaBlue font-bold bg-slate-50/50 flex-1 min-w-fit flex items-center justify-center transition-colors whitespace-nowrap group";
            
            let icon = btn.querySelector('i');
            if(icon) {
              icon.classList.remove('text-slate-400', 'group-hover:text-slate-500');
            }
          } else {
            section.classList.add('hidden');
            section.classList.remove('block');
            btn.className = "py-4 px-4 sm:px-6 text-slate-500 font-medium hover:bg-slate-100 hover:text-slate-700 border-b-2 border-transparent flex-1 min-w-fit flex items-center justify-center transition-colors whitespace-nowrap group";
            
            let icon = btn.querySelector('i');
            if(icon) {
              icon.classList.add('text-slate-400', 'group-hover:text-slate-500');
            }
          }
        }
      });

      resetAllFormState();

      const loadingScreen = document.getElementById('loadingScreen');
      const mainContent = document.getElementById('mainContent');
      if (loadingScreen) loadingScreen.classList.remove('hidden');
      if (mainContent) mainContent.classList.add('hidden');

      if (typeof fetchData === 'function') {
        fetchData();
      }
    }
  </script>
  
