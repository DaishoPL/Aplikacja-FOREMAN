      let selectedFound = false;
      uniqueRooms.forEach(({ roomNumber, roomName }) => {
        const label = `${roomNumber || ''}${roomNumber && roomName ? ' - ' : ''}${roomName || ''}`.trim();
        let opt = document.createElement('option');
        opt.value = roomNumber || roomName;
        opt.innerText = label || roomNumber || roomName;
        roomSelect.appendChild(opt);
        if ((roomNumber || roomName) === previousRoom && previousRoom !== '') {
          opt.selected = true;
          selectedFound = true;
        }
      });

      if (uniqueRooms.length === 0) {
      } else {
      }

      if (deck && area && appData && appData.tasksTree && appData.tasksTree[deck] && appData.tasksTree[deck][area]) {
        appData.tasksTree[deck][area].forEach(t => {
          if (String(t.roomId || '').trim() !== String(previousRoom || '').trim() && previousRoom) return;
          const taskId = String(t.taskId || '').trim();
          const taskName = String(t.taskName || t.taskType || '').trim();
          const displayLabel = taskId && taskName ? `${taskId} - ${taskName}` : taskName;
          if (!displayLabel) return;
          let opt = document.createElement('option');
          opt.value = taskName; opt.innerText = displayLabel;
          opt.dataset.row = t.row;
          opt.dataset.progress = t.progress;
          opt.dataset.taskType = String(t.taskType || '').trim();
          opt.dataset.taskId = taskId;
          opt.dataset.unit = String(t.unit || '').trim();
          opt.dataset.amount = t.amount || 0;
          taskSelect.appendChild(opt);
        });
      }

      let customOpt = document.createElement('option');
      customOpt.value = "__CUSTOM__";
      customOpt.innerText = "➕ Inne zadanie (wpisz ręcznie)";
      taskSelect.appendChild(customOpt);
      taskSelect.disabled = false;
      taskSelect.classList.remove('bg-gray-100', 'opacity-60');
      taskSelect.classList.add('bg-white');
    }
  }

  function onTaskChange() {
    const select = document.getElementById('taskSelect');
    const customTaskContainer = document.getElementById('customTaskContainer');
    const taskTypeSelect = document.getElementById('taskTypeSelect');
    const opt = select.options[select.selectedIndex];
    window.taskLengthEditorOpen = false;
    window.confirmedTaskLength = 0;
    const lengthConfirmButton = document.getElementById('taskLengthConfirm');
    if (lengthConfirmButton) {
      lengthConfirmButton.textContent = 'Potwierdź długość';
      lengthConfirmButton.classList.remove('bg-green-800');
      lengthConfirmButton.classList.add('bg-green-600', 'hover:bg-green-700');
    }

    if (taskTypeSelect && opt && opt.dataset && opt.dataset.taskType) {
      taskTypeSelect.value = opt.dataset.taskType;
    }

    if (select.value === "__CUSTOM__") {
      if(customTaskContainer) customTaskContainer.classList.remove('hidden');
      if (taskTypeSelect) {
        taskTypeSelect.disabled = false;
        taskTypeSelect.classList.remove('bg-slate-100', 'text-slate-500', 'cursor-not-allowed');
      }
      document.getElementById('taskRowNumber').value = "";
      // Wyczyść typ zadania, ID i jednostkę odziedziczone po przypadkowo klikniętym istniejącym zadaniu.
      if (taskTypeSelect) taskTypeSelect.value = '';
      document.getElementById('customTaskIdInput').value = '';
      document.getElementById('customTaskIdInput').readOnly = false;
      document.getElementById('customTaskIdInput').classList.remove('bg-slate-100', 'text-slate-500');
      document.getElementById('customTaskIdInput').placeholder = 'ID opcjonalne - zostanie wygenerowane automatycznie';
      document.getElementById('taskUnitSelect').value = '';
      document.getElementById('taskUnitSelect').disabled = false;
      const quantityContainer = document.getElementById('taskQuantityContainer');
      const quantityLabel = document.getElementById('taskQuantityLabel');
      const quantityInput = document.getElementById('taskQuantityInput');
      const editButton = document.getElementById('editTaskQuantityButton');
      if (editButton) editButton.classList.add('hidden');
      if (quantityLabel) quantityLabel.textContent = 'Ile szt.';
      if (quantityInput) {
        quantityInput.readOnly = false;
        quantityInput.value = '';
      }
      window.taskLengthEditorOpen = true;
      toggleTaskQuantity();
      refreshTaskNameSuggestions();
      document.getElementById('progressRange').value = 0;
      document.getElementById('progressValue').innerText = '0%';
      document.getElementById('progressSection').classList.remove('hidden');
    } else {
      if(customTaskContainer) customTaskContainer.classList.add('hidden');
      if (taskTypeSelect) {
        taskTypeSelect.value = opt.dataset.taskType || '';
        taskTypeSelect.disabled = true;
        taskTypeSelect.classList.add('bg-slate-100', 'text-slate-500', 'cursor-not-allowed');
      }
      document.getElementById('taskRowNumber').value = opt.dataset.row;
      document.getElementById('customTaskIdInput').value = opt.dataset.taskId || '';
      document.getElementById('customTaskIdInput').readOnly = true;
      document.getElementById('customTaskIdInput').classList.add('bg-slate-100', 'text-slate-500');
      document.getElementById('customTaskIdInput').placeholder = 'ID przypisane do zadania';
      const unitSelect = document.getElementById('taskUnitSelect');
      unitSelect.value = opt.dataset.unit || '';
      unitSelect.disabled = true;
      updateRoomDimensionsPanel();
      toggleTaskQuantity();
      const quantityContainer = document.getElementById('taskQuantityContainer');
      const quantityLabel = document.getElementById('taskQuantityLabel');
      const quantityInput = document.getElementById('taskQuantityInput');
      const lengthInput = document.getElementById('taskLengthInput');
      const savedAmount = opt.dataset.amount || '';
      const isLengthTask = String(opt.dataset.unit || '').toLowerCase() === 'm';
      window.taskLengthEditorOpen = isLengthTask;
      if (quantityLabel) quantityLabel.textContent = 'Zapamiętana ilość / powierzchnia';
      const editButton = document.getElementById('editTaskQuantityButton');
      if (editButton) editButton.classList.toggle('hidden', String(opt.dataset.unit || '').toLowerCase() !== 'm');
      if (quantityInput) {
        quantityInput.readOnly = String(opt.dataset.unit || '').toLowerCase() !== 'pis';
        quantityInput.required = false;
        quantityInput.value = String(opt.dataset.unit || '').toLowerCase() === 'pis' ? savedAmount : '';
      }
      if (lengthInput) {
        lengthInput.readOnly = false;
        lengthInput.required = false;
        lengthInput.value = String(opt.dataset.unit || '').toLowerCase() === 'm' ? savedAmount : '';
      }
      if (quantityContainer) quantityContainer.classList.toggle('hidden', String(opt.dataset.unit || '').toLowerCase() !== 'pis');
      const lengthContainer = document.getElementById('taskLengthContainer');
      if (lengthContainer) lengthContainer.classList.toggle('hidden', !isLengthTask);
      const prog = opt.dataset.progress || 0;
      document.getElementById('progressRange').value = prog;
      document.getElementById('progressValue').innerText = prog + '%';
      document.getElementById('progressSection').classList.remove('hidden');
    }
  }

  // 5. WYSYŁANIE FORMULARZA
  function toggleTaskQuantity() {
    const unit = document.getElementById('taskUnitSelect')?.value || '';
    const container = document.getElementById('taskQuantityContainer');
    const input = document.getElementById('taskQuantityInput');
    const lengthContainer = document.getElementById('taskLengthContainer');
    const lengthInput = document.getElementById('taskLengthInput');
    if (!container || !input || !lengthContainer || !lengthInput) return;
    const isPieces = unit === 'pis';
    const isLength = unit === 'm';
    container.classList.toggle('hidden', !isPieces);
    lengthContainer.classList.toggle('hidden', !isLength);
    input.required = isPieces;
    if (!isPieces) input.value = '';
    lengthInput.required = isLength;
    if (!isLength && !isPieces) lengthInput.value = '';
    updateRoomDimensionsPanel();
  }

  function getSelectedRoomDimensions() {
    const deck = getSelectedDeckValue();
    const roomValue = document.getElementById('roomSelect')?.value || '';
    const rooms = Array.isArray(appData?.rooms) ? appData.rooms : [];
    return rooms.find(room => normalizeRoomMatch(room.deck) === normalizeRoomMatch(deck) &&
      [room.room, room.name].some(value => normalizeRoomMatch(value) === normalizeRoomMatch(roomValue))) || null;
  }

  function updateRoomDimensionsPanel() {
    const room = getSelectedRoomDimensions();
    const perimeter = 2 * (Number(room?.width || 0) + Number(room?.length || 0));
    const buttons = {
      dimBtnA: ['A', room?.width],
      dimBtnB: ['B', room?.length],
      dimBtnH: ['H', room?.height],
      taskPerimeterButton: ['Obwód', perimeter]
    };
    Object.keys(buttons).forEach(id => {
      const element = document.getElementById(id);
      const label = buttons[id][0];
      const number = Number(buttons[id][1] || 0);
      if (element) element.textContent = number > 0 ? label + ' = ' + number.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 2 }) + ' m' : label + ' = - m';
    });
  }

  function fillRoomPerimeter() {
    const room = getSelectedRoomDimensions();
    const input = document.getElementById('taskLengthInput');
    if (!room || !input) return;
    const perimeter = 2 * (Number(room.width || 0) + Number(room.length || 0));
    if (perimeter > 0) {
      input.value = perimeter.toFixed(2);
    }
  }

  function selectRoomDimension(dimension) {
    const room = getSelectedRoomDimensions();
    const input = document.getElementById('taskLengthInput');
    const value = Number(room?.[{ A: 'width', B: 'length', H: 'height' }[dimension]] || 0);
    if (!input || value <= 0) return;
    input.value = value.toFixed(2);
  }

  function confirmTaskLength() {
    const lengthInput = document.getElementById('taskLengthInput');
    const quantityInput = document.getElementById('taskQuantityInput');
    const length = Number(lengthInput?.value || 0);
    if (!length || length <= 0) {
      alert('Wpisz długość pracy lub wybierz L = obwód.');
      lengthInput?.focus();
      return;
    }
    if (quantityInput) quantityInput.value = length.toFixed(2);
    window.confirmedTaskLength = length;
    window.taskLengthEditorOpen = false;
    const button = document.getElementById('taskLengthConfirm');
    if (button) {
      button.textContent = 'ZAPISANO';
      button.classList.remove('bg-green-600', 'hover:bg-green-700');
      button.classList.add('bg-green-800');
    }
    const lengthContainer = document.getElementById('taskLengthContainer');
    if (lengthContainer) lengthContainer.classList.add('hidden');
    const quantityContainer = document.getElementById('taskQuantityContainer');
    if (quantityContainer) quantityContainer.classList.remove('hidden');
    const quantityLabel = document.getElementById('taskQuantityLabel');
    if (quantityLabel) quantityLabel.textContent = 'Zapamiętana ilość / powierzchnia';
  }

  function openTaskLengthEditor() {
    const unit = document.getElementById('taskUnitSelect')?.value || '';
    if (unit !== 'm') return;
    window.taskLengthEditorOpen = true;
    const savedValue = Number(document.getElementById('taskQuantityInput')?.value || 0);
    const lengthInput = document.getElementById('taskLengthInput');
    if (lengthInput && savedValue > 0) lengthInput.value = savedValue;
    updateRoomDimensionsPanel();
    const lengthContainer = document.getElementById('taskLengthContainer');
    if (lengthContainer) lengthContainer.classList.remove('hidden');
  }

  function submitForm(event) {
    event.preventDefault();

    const timeStart = document.getElementById('timeStart').value;
    const timeEnd = document.getElementById('timeEnd').value;
    const workDate = document.getElementById('workDate').value;
    const mode = document.querySelector('input[name="assignMode"]:checked')?.value || 'tech';
    const target = document.getElementById('assignTarget').value;

    if (timeStart >= timeEnd) {
      showTimeError('Godziny są niepoprawne!');
      return;
    }

    const selectedTechs = mode === 'tech'
      ? (appData.techniciansDetails || []).filter(t => t.name === target && isActiveTechnician(t)).map(t => t.name)
      : (appData.techniciansDetails || []).filter(t => t.team === target && isActiveTechnician(t)).map(t => t.name);

    if (selectedTechs.length === 0) {
      alert('Wybrana grupa nie ma aktywnych techników.');
      return;
    }

    google.script.run
      .withSuccessHandler(tasks => {
        const conflicts = (tasks || []).filter(t => tasksOverlap(timeStart, timeEnd, t.start, t.end));
        if (conflicts.length > 0) {
          const names = [...new Set(conflicts.map(t => t.techName))].join(', ');
          alert('Nie można zapisać zadania. Konflikt godzin z technikami: ' + names);
          return;
        }

        continueSubmitForm();
      })
      .withFailureHandler(err => {
        console.error('Błąd sprawdzania konfliktów:', err);
        alert('Nie można sprawdzić konfliktów godzinowych.');
      })
      .getTasksForTechnicians(selectedTechs, workDate, timeStart, timeEnd);

    function continueSubmitForm() {
      let selectedDeck = document.getElementById('deckSelect').value;
    if (selectedDeck === "__CUSTOM_DECK__") {
      selectedDeck = document.getElementById('customDeckInput').value.trim();
      if(!selectedDeck) { alert("Wpisz nazwę pokładu!"); return; }
    }
    if (!selectedDeck) { alert("Wybierz lub wpisz pokład!"); return; }

    let selectedArea = document.getElementById('areaSelect').value;
    if (selectedArea === "__CUSTOM__") {
      selectedArea = document.getElementById('customAreaInput').value.trim();
      if(!selectedArea) { alert("Wpisz nazwę obszaru!"); return; }
    }
    if (!selectedArea) { alert("Wybierz powierzchnię lub strefę!"); return; }

    let selectedRoom = document.getElementById('roomSelect').value;
    // Break/Travel nie dotyczą konkretnego pomieszczenia, więc pokój nie jest tu wymagany.
    const deckForRoomCheck = String(selectedDeck || '').trim().toUpperCase();
    const isRoomOptionalTask = deckForRoomCheck === 'TRAVEL' || deckForRoomCheck === 'BREAK';
    if (selectedRoom === "__CUSTOM__") {
      selectedRoom = document.getElementById('customRoomInput').value.trim();
      if (!selectedRoom && !isRoomOptionalTask) { alert("Wpisz numer pokoju!"); return; }
      window.currentRoomSurface = 0;
    }
    if (!selectedRoom && !isRoomOptionalTask) {
      alert("Wybierz pokój!"); return;
    }
    const selectedRoomSurface = Number(window.currentRoomSurface) || 0;
    
    let isCustomTaskFlag = false; // NOWA FLAGA DO BACKENDU
    let selectedTask = document.getElementById('taskSelect').value;
    let customTaskIdValue = "";
    const rawTaskType = (document.getElementById('taskTypeSelect')?.value || '').trim();
    const taskType = normalizeTaskType(rawTaskType);
    const taskUnitSelectEl = document.getElementById('taskUnitSelect');
    let taskUnit = (taskUnitSelectEl?.value || '').trim();
    if (!taskUnit && isRoomOptionalTask) {
      // Break/Travel są rozliczane godzinowo, więc jednostka "h" jest tu domyślna.
      taskUnit = 'h';
      if (taskUnitSelectEl) taskUnitSelectEl.value = 'h';
    }
    const taskQuantity = Number(document.getElementById('taskQuantityInput')?.value || 0);
    const taskLength = Number(document.getElementById('taskLengthInput')?.value || 0);
    const taskLengthConfirmed = taskUnit === 'm' && taskLength > 0;
    const isExtraJob = document.getElementById('extraJobCheckbox')?.checked || false;
    
    if (!isRoomOptionalTask && (!taskType || taskType === '__OTHER__')) {
      alert('Wybierz typ zadania z listy. Dopuszczone wartości: ROZBIÓRKA, MONTAŻ, ROZBIÓRKA Z ODZYSKIEM, MONTAŻ Z ODZYSKU.');
      return;
    }

    const taskTypeSelect = document.getElementById('taskTypeSelect');
    if (taskTypeSelect) taskTypeSelect.value = taskType;
    if (!selectedTask) {
      alert('Wybierz zadanie lub opcję dodania nowego zadania.');
      return;
    }
    if (selectedTask === '__CUSTOM__' && !taskUnit) {
      alert('Wybierz jednostkę miary przed zapisaniem nowego zadania.');
      document.getElementById('taskUnitSelect').focus();
      return;
    }
    if (selectedTask === '__CUSTOM__' && taskUnit === 'pis' && (!Number.isInteger(taskQuantity) || taskQuantity < 1)) {
      alert('Wpisz liczbę całkowitą sztuk większą od zera.');
      return;
    }
    const isNewTask = selectedTask === '__CUSTOM__';
    if (taskUnit === 'm' && taskLength <= 0) {
      alert('Wpisz długość pracy lub wybierz jeden z wymiarów pomieszczenia.');
      document.getElementById('taskLengthInput').focus();
      return;
    }
    if (taskUnit === 'pis' && (!Number.isInteger(taskQuantity) || taskQuantity < 1)) {
      alert('Wpisz liczbę całkowitą sztuk większą od zera.');
      document.getElementById('taskQuantityInput').focus();
      return;
    }

    if (selectedTask === "__CUSTOM__") {
      selectedTask = document.getElementById('customTaskInput').value.trim();
      customTaskIdValue = document.getElementById('customTaskIdInput').value.trim(); // POBIERANIE ID
      isCustomTaskFlag = true;
      if(!selectedTask) { alert("Wpisz nazwę zadania!"); return; }
    }
    // Ustalanie kto dostanie zadanie (Jeden technik czy cała lista)
    let techsToAssign = [];
    const mode = document.querySelector('input[name="assignMode"]:checked').value;
    const target = document.getElementById('assignTarget').value;
    
    if (!target) { alert("Wybierz technika lub team!"); return; }
    if (mode === 'tech') {
       techsToAssign = (appData.techniciansDetails || []).filter(t => t.name === target && isActiveTechnician(t)).map(t => t.name);
    } else {
       techsToAssign = (appData.techniciansDetails || []).filter(t => t.team === target && isActiveTechnician(t)).map(t => t.name);
    }
    if (techsToAssign.length === 0) {
      alert("Wybrana grupa nie ma techników. Nie można przypisać zadania.");
      return;
    }
      const btn = document.getElementById('submitBtn');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Zapisywanie w bazie...';
      btn.disabled = true;
      const formData = {
        techniciansArray: techsToAssign,
        workDate: document.getElementById('workDate').value,
        timeStart: timeStart,
        timeEnd: timeEnd,
        deck: selectedDeck,
        area: selectedArea,
        roomId: selectedRoom,
        roomSurface: selectedRoomSurface,
        taskType: taskType,
        taskUnit: taskUnit,
        taskQuantity: taskQuantity,
        taskLength: taskLength,
        taskLengthConfirmed: taskLengthConfirmed,
        taskName: selectedTask,
        taskRow: document.getElementById('taskRowNumber').value,
        progress: document.getElementById('progressRange').value,
        isCustomTask: isCustomTaskFlag,
        isExtraJob: isExtraJob,
        customTaskId: customTaskIdValue
      };

      google.script.run
        .withSuccessHandler(res => {
          if (res && res.success) {
            alert(res.message);
            // ZMIANA: Odśwież pełne dane ze skoroszytu, aby nowe zadanie z DK3 zostało załadowane
            fetchData();
            document.getElementById('deckSelect').value = "";
            document.getElementById('areaSelect').value = "";
            document.getElementById('roomSelect').value = "";
            document.getElementById('customAreaInput').value = "";
            document.getElementById('customRoomInput').value = "";
            document.getElementById('taskSelect').value = "";
            document.getElementById('taskUnitSelect').value = "";
            document.getElementById('taskQuantityInput').value = "";
            toggleTaskQuantity();
            document.getElementById('customTaskInput').value = "";
            document.getElementById('customTaskIdInput').value = "";
            document.getElementById('timeStart').value = "";
            document.getElementById('timeEnd').value = "";
          } else {
            alert("Błąd: " + (res ? res.message : "Brak odpowiedzi serwera"));
          }
          btn.innerHTML = '<span>Zapisz i prześlij</span><i class="fa-solid fa-paper-plane ml-3"></i>';
          btn.disabled = false;
        })
        .submitWorkReport(formData);
    }
  }

  function promptAddTechnician() {
    const name = prompt("Podaj imię i nazwisko nowego technika:");
    if (name && name.trim() !== "") {
      refreshData();
      google.script.run
        .withSuccessHandler(response => {
          if(response.success) {
            alert(response.message);
            fetchData();
          } else {
            alert("Błąd: " + response.message);
            fetchData();
          }
        })
        .addTechnician(name);
    }
  }
</script>
