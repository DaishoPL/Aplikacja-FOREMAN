  function openRoomDimensionsModal(deck, area, roomSelect) {
    const modal = document.getElementById('roomDimensionsModal');
    if (!modal) return;
    const close = () => {
      modal.classList.add('hidden');
      roomSelect.value = '';
    };
    const save = () => {
      const roomName = String(document.getElementById('newRoomName').value || '').trim();
      const roomNumber = String(document.getElementById('newRoomNumber').value || '').trim();
      const length = Number(document.getElementById('newRoomLength').value || 0);
      const width = Number(document.getElementById('newRoomWidth').value || 0);
      const height = Number(document.getElementById('newRoomHeight').value || 0);
      if ((!roomName && !roomNumber) || length <= 0 || width <= 0 || height <= 0) {
        alert('Wpisz nazwę lub numer pomieszczenia oraz dodatnie wymiary.');
        return;
      }
      const surface = length * width;
      const wallSurface = 2 * (length + width) * height;
      const selectedRoomValue = roomNumber || roomName;
      const payload = { deck, area, name: roomName, room: roomNumber, width, length, height, surface, ceilingSurface: surface, wallSurface };
      const saveButton = document.getElementById('saveRoomDimensions');
      saveButton.disabled = true;
      google.script.run
        .withSuccessHandler(res => {
          saveButton.disabled = false;
          if (!res || !res.success) {
            alert('Błąd dodania pomieszczenia: ' + (res ? res.message : 'Brak odpowiedzi serwera'));
            return;
          }
          modal.classList.add('hidden');
          window.pendingRoomRecord = { deck, area, name: roomName, room: roomNumber, surface };
          document.getElementById('newRoomName').value = '';
          document.getElementById('newRoomNumber').value = '';
          document.getElementById('newRoomLength').value = '';
          document.getElementById('newRoomWidth').value = '';
          document.getElementById('newRoomHeight').value = '';
          const newRoomOption = [...roomSelect.options].find(option => option.value === selectedRoomValue);
          if (newRoomOption) {
            newRoomOption.selected = true;
          } else {
            const option = document.createElement('option');
            option.value = selectedRoomValue;
            option.innerText = [roomNumber, roomName].filter(Boolean).join(' - ');
            option.selected = true;
            roomSelect.appendChild(option);
          }
          window.currentRoomSurface = surface;
          roomSelect.disabled = false;
          roomSelect.removeAttribute('disabled');
          roomSelect.classList.remove('bg-gray-100', 'opacity-60');
          roomSelect.classList.add('bg-white');
          onRoomChange();
        })
        .withFailureHandler(err => {
          saveButton.disabled = false;
          alert('Nie udało się dodać pomieszczenia: ' + err);
        })
        .saveRoomRecord(payload);
    };
    modal.classList.remove('hidden');
    document.getElementById('closeRoomDimensions').onclick = close;
    document.getElementById('cancelRoomDimensions').onclick = close;
    document.getElementById('saveRoomDimensions').onclick = save;
