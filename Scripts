  function getSelectedDeckValue() {
    const deckSelect = document.getElementById('deckSelect');
    const customDeckInput = document.getElementById('customDeckInput');
    const selectedDeck = deckSelect ? deckSelect.value : '';
    if (selectedDeck === '__CUSTOM_DECK__') {
      return (customDeckInput ? customDeckInput.value.trim() : '').trim();
    }
    return String(selectedDeck || '').trim();
  }

  function normalizeAreaKey(value) {
    return String(value ?? '')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z]/g, '');
  }

  function getFixedAreaOptions() {
    return [
      { value: 'PODŁOGI', label: 'Podłoga' },
      { value: 'ŚCIANY', label: 'Ściany' },
      { value: 'SUFITY', label: 'Sufit' },
      { value: 'INSTALACJE', label: 'Instalacje' }
    ];
  }

  function refreshTaskNameSuggestions() {
    const list = document.getElementById('taskNameSuggestions');
    if (!list) return;
    const names = Object.values((appData && appData.tasksTree) || {})
      .flatMap(areas => Object.values(areas).flat())
      .map(item => String(item.taskName || '').trim())
      .filter(Boolean);
    list.innerHTML = [...new Map(names.map(name => [name.toLowerCase(), name])).values()]
      .map(name => `<option value="${name.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}"></option>`)
      .join('');
  }

  function matchFixedArea(value) {
    const normalized = String(value ?? '')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z]/g, '');

    if (normalized.includes('sciany') || normalized.includes('sciana')) return 'ŚCIANY';
    if (normalized.includes('podloga') || normalized.includes('podlogi')) return 'PODŁOGI';
    if (normalized.includes('sufit') || normalized.includes('sufity')) return 'SUFITY';
    if (normalized.includes('instalac')) return 'INSTALACJE';
    if (normalized.includes('meble')) return 'INSTALACJE';
    return String(value ?? '').trim();
  }

  function normalizeRoomMatch(value) {
    return String(value ?? '').trim().toLowerCase().replace(/\s+/g, '');
  }

  function normalizeTaskType(value) {
    const raw = String(value ?? '').trim();
    if (!raw) return '';
    const upper = raw.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    const compact = upper.replace(/\s+/g, ' ').trim();
    const map = {
      'ROZBIORKA': 'ROZBIÓRKA',
      'MONTAZ': 'MONTAŻ',
      'ROZBIORKA Z ODZYSKIEM': 'ROZBIÓRKA Z ODZYSKIEM',
      'MONTAZ Z ODZYSKU': 'MONTAŻ Z ODZYSKU',
      'MONTAZ Z ODZYSKIEM': 'MONTAŻ Z ODZYSKU'
    };
    return map[compact] || compact;
  }

  function getAreaSurfaceField(area) {
    const normalized = String(area || '').trim().toUpperCase();
    if (normalized === 'ŚCIANY') return 'wallSurface';
    if (normalized === 'SUFITY') return 'ceilingSurface';
    return 'surface';
  }

  function resolveRoomSurface() {
    updateRoomDimensionsPanel();
    const deck = getSelectedDeckValue();
    const area = document.getElementById('areaSelect')?.value;
    const roomSelect = document.getElementById('roomSelect');
    const customRoomInput = document.getElementById('customRoomInput');
    const roomValue = roomSelect && roomSelect.value && roomSelect.value !== '__CUSTOM__' ? roomSelect.value : (customRoomInput ? customRoomInput.value.trim() : '');

    if (!deck || !roomValue) {
      window.currentRoomSurface = 0;
      return;
    }

    const surfaceField = getAreaSurfaceField(area);
    const roomCatalog = Array.isArray(appData && appData.rooms) ? appData.rooms : [];
    const catalogMatch = roomCatalog.find(room => {
      const sameDeck = normalizeRoomMatch(String(room.deck || '')) === normalizeRoomMatch(String(deck || ''));
      const roomName = String(room.name || '').trim();
      const roomNumber = String(room.room || '').trim();
      const sameRoom = normalizeRoomMatch(roomNumber) === normalizeRoomMatch(roomValue) || normalizeRoomMatch(roomName) === normalizeRoomMatch(roomValue);
      return sameDeck && sameRoom;
    });

    if (catalogMatch) {
      const surface = Number(catalogMatch[surfaceField] || 0) || (Number(catalogMatch.width || 0) * Number(catalogMatch.length || 0));
      window.currentRoomSurface = Number(surface) || 0;
      return;
    }

    google.script.run
      .withSuccessHandler(value => {
        window.currentRoomSurface = Number(value) || 0;
      })
      .withFailureHandler(() => {
        window.currentRoomSurface = 0;
      })
      .getRoomSurface(deck, area || '', roomValue);
  }

