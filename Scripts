<script>
  let appData = null;
  let currentTechSchedule = [];

  // 1. INICJALIZACJA
  window.onload = function() {
    const today = new Date().toISOString().split('T')[0];
    if(document.getElementById('workDate')) document.getElementById('workDate').value = today;
    if(document.getElementById('infoDate')) document.getElementById('infoDate').innerText = new Date().toLocaleDateString('pl-PL');
    fetchData();
  };

  function refreshData() {
    console.log('Manual refresh: pobieram dane z pliku/bazy...');
    const loadingScreen = document.getElementById('loadingScreen');
    const mainContent = document.getElementById('mainContent');
    if (loadingScreen) loadingScreen.classList.remove('hidden');
    if (mainContent) mainContent.classList.add('hidden');
    fetchData();
  }

  function fetchData() {
    if (typeof google === 'undefined' || !google.script) {
      console.warn('google.script jest niedostępne, brak połączenia z backendem.');
      return;
    }

    google.script.run
      .withSuccessHandler((data) => {
        appData = data;
        window.initialData = data;
        onDataLoaded(data);
      })
      .withFailureHandler(err => {
          console.error('Błąd pobierania:', err);
          alert('Błąd pobierania danych z serwera: ' + err);
          const loadingScreen = document.getElementById('loadingScreen');
          const mainContent = document.getElementById('mainContent');
          if (loadingScreen) loadingScreen.classList.add('hidden');
          if (mainContent) mainContent.classList.remove('hidden');
      })
      .getInitialData();
  }

  // 2. WYPEŁNIANIE DANYCH PO POBRANIU
  function onDataLoaded(data) {
    console.log("Dane pobrane z serwera:", data);
    appData = data;
    window.initialData = data;
    
    // Konfiguracja przełącznika Technik/Team
    if (typeof switchAssignMode === 'function') {
      switchAssignMode();
    }
    const deckSelect = document.getElementById('deckSelect');
    let totalTasks = 0;
    
    if(deckSelect && data.tasksTree) {
      deckSelect.innerHTML = '<option value="" disabled selected>Najpierw wybierz pokład...</option>';
      Object.keys(data.tasksTree).sort().forEach(deck => {
        let opt = document.createElement('option');
        opt.value = deck; opt.innerText = deck;
        deckSelect.appendChild(opt);
        Object.keys(data.tasksTree[deck]).forEach(area => {
          totalTasks += data.tasksTree[deck][area].length;
        });
      });

      const customDeckOpt = document.createElement('option');
      customDeckOpt.value = '__CUSTOM_DECK__';
      customDeckOpt.innerText = '➕ Dodaj nowy pokład (wpisz ręcznie)';
      deckSelect.appendChild(customDeckOpt);
    }
    // ODBLOKOWANIE EKRANU
    const loadingScreen = document.getElementById('loadingScreen');
    const mainContent = document.getElementById('mainContent');
    if (loadingScreen) loadingScreen.classList.add('hidden');
    if (mainContent) mainContent.classList.remove('hidden');
    
    // Uruchomienie zew. skryptów
    if (typeof initDashboard === 'function') initDashboard(data);
    if (typeof renderTechnicians === 'function') renderTechnicians(data);
    if (typeof renderRoomsTable === 'function') renderRoomsTable(data);
  }

  function isActiveTechnician(tech) {
    if (!tech || !tech.name) return false;
    const status = String(tech.status || '').trim().toLowerCase();
    const normalized = status.replace(/[^a-z]/g, '');

    if (!normalized) return false;

    const inactiveValues = ['nieaktywny', 'inactive', 'offline', 'off', 'disabled', 'nieaktywna'];
    const activeValues = ['aktywny', 'active', 'aktywna', 'working', 'online', 'wpracy', 'pracuje'];

    if (inactiveValues.some(v => normalized.includes(v.replace(/[^a-z]/g, '')))) return false;
    return activeValues.some(v => normalized === v || normalized.includes(v));
  }

  // --- NOWE: OBSŁUGA PRZEŁĄCZNIKA TECHNIK / TEAM ---
  function switchAssignMode() {
    const modeObj = document.querySelector('input[name="assignMode"]:checked');
    if (!modeObj || !appData) return;
    const mode = modeObj.value;
    
    const targetSelect = document.getElementById('assignTarget');
    const label = document.getElementById('assignTargetLabel');
    targetSelect.innerHTML = '<option value="" disabled selected>Wybierz...</option>';

    const activeTechnicians = (appData.techniciansDetails || []).filter(isActiveTechnician);

    if (mode === 'tech') {
      label.innerText = 'Wybierz technika';
      activeTechnicians.forEach(tech => {
        let opt = document.createElement('option');
        opt.value = tech.name; opt.innerText = tech.name;
        targetSelect.appendChild(opt);
      });
    } else {
      label.innerText = 'Wybierz drużynę (Team)';
      const teams = [...new Set(activeTechnicians.map(t => t.team).filter(t => t && t !== ''))].sort();
      teams.forEach(team => {
        let opt = document.createElement('option');
        opt.value = team; opt.innerText = team;
        targetSelect.appendChild(opt);
      });
    }
    onTargetOrDateChange();
  }

  // 3. OBSŁUGA FORMULARZA KARTY ZADAŃ
  function onTargetOrDateChange() {
    const modeObj = document.querySelector('input[name="assignMode"]:checked');
    if(!modeObj) return;
    const mode = modeObj.value;
    const target = document.getElementById('assignTarget').value;
    const date = document.getElementById('workDate').value;
    const scheduleSection = document.getElementById('scheduleSection');
    const scheduleList = document.getElementById('scheduleList');
    const scheduleTitle = document.getElementById('scheduleTitle');
    const timeStart = document.getElementById('timeStart').value;
    const timeEnd = document.getElementById('timeEnd').value;
    resetTimeErrors();

    if (!target || !date || !scheduleSection) {
      if (scheduleSection) scheduleSection.classList.add('hidden');
      currentTechSchedule = [];
      return;
    }

    scheduleSection.classList.remove('hidden');
    scheduleTitle.innerText = mode === 'tech' ? 'Zadania technika w wybranym przedziale' : 'Zadania teamu w wybranym przedziale';

    let techsToQuery = [];
    if (mode === 'tech') {
      techsToQuery = (appData.techniciansDetails || []).filter(t => t.name === target && isActiveTechnician(t)).map(t => t.name);
    } else {
      techsToQuery = (appData.techniciansDetails || []).filter(t => t.team === target && isActiveTechnician(t)).map(t => t.name);
    }

    if (techsToQuery.length === 0) {
      scheduleList.innerHTML = '<li class="text-orange-500 font-medium">Brak aktywnych techników przypisanych do tego teamu.</li>';
      currentTechSchedule = [];
      return;
    }

    if (!timeStart || !timeEnd || timeStart >= timeEnd) {
      scheduleList.innerHTML = '<li class="text-slate-500 font-medium">Wybierz godzinę rozpoczęcia i zakończenia, aby zobaczyć zadania w tym przedziale czasu.</li>';
      currentTechSchedule = [];
      return;
    }

    scheduleList.innerHTML = '<li class="text-slate-500 italic"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Pobieranie harmonogramu...</li>';

    google.script.run
      .withSuccessHandler(tasks => {
        currentTechSchedule = tasks || [];
        if (!currentTechSchedule.length) {
          scheduleList.innerHTML = '<li class="text-emerald-600 font-medium"><i class="fa-solid fa-check mr-1"></i> Brak zadań w tym przedziale czasu.</li>';
        } else {
          scheduleList.innerHTML = currentTechSchedule.map(t => {
            const taskPayload = encodeURIComponent(JSON.stringify(t));
            return `<li class="flex justify-between items-center group py-2 border-b border-slate-100 last:border-0 gap-2">
               <span class="flex-1 min-w-0">
                 ${mode === 'team' ? `<span class="font-bold text-slate-500 mr-2">[${t.techName}]</span>` : ''}
                 <span class="text-candidoRed font-bold mr-2">${t.start} - ${t.end}</span>
                 <span class="text-slate-400">|</span> ${t.deck}
                 <span class="text-slate-400">|</span> ${t.taskName}
               </span>
               <span class="flex items-center gap-2">
                 <button type="button" data-task="${taskPayload}" onclick="editTaskEntryFromSchedule(this.dataset.task)" class="text-slate-500 hover:text-seaviaBlue transition-colors p-1 px-2" title="Edytuj zadanie technika">
                   <i class="fa-solid fa-pen"></i>
                 </button>
                 <button type="button" onclick="cancelTask(${t.dbRowIndex})" class="text-slate-300 hover:text-red-500 transition-colors p-1 px-2" title="Anuluj to zadanie w bazie">
                   <i class="fa-solid fa-trash-can"></i>
                 </button>
               </span>
             </li>`;
          }).join('');
        }
        validateTimes();
      })
      .getTasksForTechnicians(techsToQuery, date, timeStart, timeEnd);
  }

  function editTaskEntryFromSchedule(taskJson) {
    try {
      const task = JSON.parse(decodeURIComponent(taskJson || ''));
      if (task) editTaskEntry(task);
    } catch (err) {
      console.error('Błąd odczytu zadania do edycji:', err);
      alert('Nie udało się otworzyć edycji zadania.');
    }
  }

  function editTaskEntry(task) {
    if (!task || !task.dbRowIndex) {
      alert('Brak danych zadania do edycji.');
      return;
    }

    const modalId = 'editTaskModal';
    const existingModal = document.getElementById(modalId);
    if (existingModal) existingModal.remove();

    const modal = document.createElement('div');
    modal.id = modalId;
    modal.style.position = 'fixed';
    modal.style.inset = '0';
    modal.style.background = 'rgba(15, 23, 42, 0.55)';
    modal.style.display = 'flex';
    modal.style.alignItems = 'center';
    modal.style.justifyContent = 'center';
    modal.style.zIndex = '9999';

    const deckList = Object.keys((appData && appData.tasksTree) || {}).sort();
    const currentDeck = (task.deck || '').trim();
    const currentArea = task.area || '';
    const currentRoom = task.roomId || '';
    const currentTaskName = task.taskName || '';

    const taskOptions = [];
    if (appData && appData.tasksTree) {
      Object.keys(appData.tasksTree).forEach(deck => {
        Object.keys(appData.tasksTree[deck] || {}).forEach(area => {
          (appData.tasksTree[deck][area] || []).forEach(item => {
            taskOptions.push({
              deck,
              area,
              taskName: item.taskName,
              row: item.row,
              roomId: item.roomId || ''
            });
          });
        });
      });
    }

    const deckOptions = deckList.map(deck => `<option value="${deck}" ${deck === currentDeck ? 'selected' : ''}>${deck}</option>`).join('');
    const areaOptions = (() => {
      if (!appData || !appData.tasksTree || !currentDeck) return '<option value="">Brak strefy</option>';
      const areas = Object.keys(appData.tasksTree[currentDeck] || {}).sort();
      if (!areas.length) return '<option value="">Brak strefy</option>';
      return areas.map(area => `<option value="${area}" ${area === currentArea ? 'selected' : ''}>${area}</option>`).join('');
    })();

    const roomOptions = (() => {
      const roomCatalog = Array.isArray(appData && appData.rooms) ? appData.rooms : [];
      const deckRooms = roomCatalog.filter(room => String(room.deck || '').trim().toUpperCase() === String(currentDeck || '').trim().toUpperCase());
      const rooms = [...new Set(deckRooms.map(room => String(room.room || room.name || '').trim()).filter(Boolean))];
      if (!rooms.length) return '<option value="">Brak pokoi</option>';
      return rooms.map(room => `<option value="${room}" ${room === currentRoom ? 'selected' : ''}>${room}</option>`).join('');
    })();

    const taskNameOptions = (() => {
      const names = taskOptions
        .filter(item => (!currentDeck || item.deck === currentDeck) && (!currentArea || item.area === currentArea))
        .map(item => item.taskName)
        .filter(Boolean);
      const uniqueNames = [...new Set(names)];
      if (!uniqueNames.length) return '<option value="">Brak zadań</option>';
      return uniqueNames.map(name => `<option value="${name}" ${name === currentTaskName ? 'selected' : ''}>${name}</option>`).join('');
    })();

    modal.innerHTML = `
      <div style="width:min(700px,90vw); background:white; border-radius:16px; box-shadow:0 30px 60px rgba(15,23,42,.25); border:1px solid #e2e8f0; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
          <h3 style="margin:0; font-size:20px; color:#0f172a; font-weight:700;">Edytuj zadanie technika</h3>
          <button type="button" id="closeEditTaskModal" style="border:none; background:#f1f5f9; color:#0f172a; width:36px; height:36px; border-radius:999px; cursor:pointer; font-size:18px;">✕</button>
        </div>
        <div style="padding:24px; display:grid; gap:16px;">
          <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px;">
            <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#334155; font-size:13px;">
              Od godziny
              <input id="editTaskStart" type="time" value="${task.start || '08:00'}" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; font-size:14px;">
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#334155; font-size:13px;">
              Do godziny
              <input id="editTaskEnd" type="time" value="${task.end || '09:00'}" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; font-size:14px;">
            </label>
          </div>
          <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#334155; font-size:13px;">
            Pokład
            <select id="editTaskDeck" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; font-size:14px;">${deckOptions}</select>
          </label>
          <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#334155; font-size:13px;">
            Powierzchnia / strefa
            <select id="editTaskArea" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; font-size:14px;">${areaOptions}</select>
          </label>
          <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#334155; font-size:13px;">
            Pokój
            <select id="editTaskRoom" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; font-size:14px;">${roomOptions}</select>
          </label>
          <label style="display:flex; flex-direction:column; gap:6px; font-weight:700; color:#334155; font-size:13px;">
            Zadanie
            <select id="editTaskName" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; font-size:14px;">${taskNameOptions}</select>
          </label>
        </div>
        <div style="padding:0 24px 24px; display:flex; justify-content:flex-end; gap:12px;">
          <button type="button" id="cancelEditTaskModal" style="border:1px solid #cbd5e1; color:#334155; background:#fff; border-radius:10px; padding:10px 18px; font-weight:700; cursor:pointer;">Anuluj</button>
          <button type="button" id="saveEditTaskModal" style="border:none; background:#0f172a; color:#fff; border-radius:10px; padding:10px 18px; font-weight:700; cursor:pointer;">Zapisz</button>
        </div>
      </div>
    `;

    document.body.appendChild(modal);

    const updateAreaOptions = () => {
      const deck = document.getElementById('editTaskDeck').value;
      const areaSelect = document.getElementById('editTaskArea');
      const areaCatalog = appData && appData.tasksTree && appData.tasksTree[deck] ? Object.keys(appData.tasksTree[deck]).sort() : [];
      areaSelect.innerHTML = areaCatalog.length ? areaCatalog.map(area => `<option value="${area}">${area}</option>`).join('') : '<option value="">Brak strefy</option>';
      updateRoomOptions();
      updateTaskOptions();
    };

    const updateRoomOptions = () => {
      const deck = document.getElementById('editTaskDeck').value;
      const roomSelect = document.getElementById('editTaskRoom');
      const roomCatalog = Array.isArray(appData && appData.rooms) ? appData.rooms : [];
      const rooms = [...new Set(roomCatalog.filter(room => String(room.deck || '').trim().toUpperCase() === String(deck || '').trim().toUpperCase()).map(room => String(room.room || room.name || '').trim()).filter(Boolean))];
      roomSelect.innerHTML = rooms.length ? rooms.map(room => `<option value="${room}">${room}</option>`).join('') : '<option value="">Brak pokoi</option>';
    };

    const updateTaskOptions = () => {
      const deck = document.getElementById('editTaskDeck').value;
      const area = document.getElementById('editTaskArea').value;
      const taskSelect = document.getElementById('editTaskName');
      const entries = [];
      if (appData && appData.tasksTree && appData.tasksTree[deck]) {
        Object.keys(appData.tasksTree[deck]).forEach(areaKey => {
          if (area && areaKey !== area) return;
          (appData.tasksTree[deck][areaKey] || []).forEach(item => entries.push(item.taskName));
        });
      }
      const unique = [...new Set(entries.filter(Boolean))];
      taskSelect.innerHTML = unique.length ? unique.map(name => `<option value="${name}">${name}</option>`).join('') : '<option value="">Brak zadań</option>';
    };

    document.getElementById('editTaskDeck').addEventListener('change', updateAreaOptions);
    document.getElementById('editTaskArea').addEventListener('change', updateTaskOptions);

    document.getElementById('closeEditTaskModal').addEventListener('click', () => modal.remove());
    document.getElementById('cancelEditTaskModal').addEventListener('click', () => modal.remove());

    document.getElementById('saveEditTaskModal').addEventListener('click', () => {
      const start = document.getElementById('editTaskStart').value.trim();
      const end = document.getElementById('editTaskEnd').value.trim();
      const deck = document.getElementById('editTaskDeck').value;
      const area = document.getElementById('editTaskArea').value;
      const roomId = document.getElementById('editTaskRoom').value;
      const taskName = document.getElementById('editTaskName').value;

      if (!start || !end || start >= end) {
        alert('Wprowadź poprawny zakres godzin.');
        return;
      }
      if (!deck || !area || !roomId || !taskName) {
        alert('Wybierz pokład, strefę, pokój i zadanie.');
        return;
      }

      const updatedPayload = {
        start,
        end,
        deck,
        area,
        roomId,
        taskName,
        techName: task.techName || ''
      };

      google.script.run
        .withSuccessHandler((res) => {
          if (res && res.success) {
            alert(res.message);
            modal.remove();
            onTargetOrDateChange();
          } else {
            alert('Błąd: ' + (res ? res.message : 'Brak odpowiedzi serwera'));
          }
        })
        .withFailureHandler((err) => {
          alert('Błąd połączenia: ' + err);
        })
        .updateWorkReportTask(task.dbRowIndex, updatedPayload);
    });
  }

  function editTaskEntry(task) {
    if (!task || !task.dbRowIndex) {
      alert('Brak danych zadania do edycji.');
      return;
    }

    const existingModal = document.getElementById('editTaskModal');
    if (existingModal) existingModal.remove();

    const taskEntries = Object.entries((appData && appData.tasksTree) || {})
      .flatMap(([deck, areas]) => Object.entries(areas || {}).flatMap(([area, items]) =>
        (items || []).map(item => ({ deck, area, ...item }))
      ));
    const taskInfo = taskEntries.find(item =>
      normalizeDeckName(item.deck) === normalizeDeckName(task.deck) &&
      String(item.area || '').trim().toLowerCase() === String(task.area || '').trim().toLowerCase() &&
      normalizeRoomMatch(item.roomId) === normalizeRoomMatch(task.roomId) &&
      String(item.taskName || '').trim().toLowerCase() === String(task.taskName || '').trim().toLowerCase()
    ) || taskEntries.find(item =>
      String(item.taskId || '').trim().toLowerCase() === String(task.taskId || '').trim().toLowerCase()
    ) || {};
    const progress = Number(taskInfo.progress) || 0;
    const modal = document.createElement('div');
    modal.id = 'editTaskModal';
    modal.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,.55);display:flex;align-items:center;justify-content:center;z-index:9999;';
    modal.innerHTML = `
      <div style="width:min(700px,90vw);background:#fff;border-radius:16px;box-shadow:0 30px 60px rgba(15,23,42,.25);overflow:hidden;">
        <div style="padding:20px 24px;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;">
          <h3 style="margin:0;font-size:20px;color:#0f172a;font-weight:700;">Edytuj zadanie technika</h3>
          <button type="button" id="closeEditTaskModal" style="border:none;background:#f1f5f9;color:#0f172a;width:36px;height:36px;border-radius:999px;cursor:pointer;font-size:18px;">✕</button>
        </div>
        <div style="padding:24px;display:grid;gap:16px;">
          <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;">
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;color:#334155;font-size:13px;">Od godziny<input id="editTaskStart" type="time" value="${task.start || '08:00'}" style="border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;font-size:14px;"></label>
            <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;color:#334155;font-size:13px;">Do godziny<input id="editTaskEnd" type="time" value="${task.end || '09:00'}" style="border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;font-size:14px;"></label>
          </div>
          <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;color:#334155;font-size:13px;">Pokład<input disabled value="${task.deck || ''}" style="background:#f1f5f9;border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;font-size:14px;"></label>
          <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;color:#334155;font-size:13px;">Pomieszczenie<input disabled value="${task.roomId || ''}" style="background:#f1f5f9;border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;font-size:14px;"></label>
          <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;color:#334155;font-size:13px;">Powierzchnia / strefa<input disabled value="${task.area || ''}" style="background:#f1f5f9;border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;font-size:14px;"></label>
          <label style="display:flex;flex-direction:column;gap:6px;font-weight:700;color:#334155;font-size:13px;">Nazwa zadania<input disabled value="${task.taskName || ''}" style="background:#f1f5f9;border:1px solid #cbd5e1;border-radius:10px;padding:10px 12px;font-size:14px;"></label>
          <label style="display:flex;flex-direction:column;gap:8px;font-weight:700;color:#334155;font-size:13px;">Procent wykonania
            <div style="display:flex;align-items:center;gap:16px;"><input id="editTaskProgress" type="range" min="0" max="100" step="5" value="${progress}" style="width:100%;accent-color:#0f3460;"><span id="editTaskProgressValue" style="width:48px;text-align:right;font-size:18px;color:#0f3460;">${progress}%</span></div>
          </label>
        </div>
        <div style="padding:0 24px 24px;display:flex;justify-content:flex-end;gap:12px;"><button type="button" id="cancelEditTaskModal" style="border:1px solid #cbd5e1;color:#334155;background:#fff;border-radius:10px;padding:10px 18px;font-weight:700;cursor:pointer;">Anuluj</button><button type="button" id="saveEditTaskModal" style="border:none;background:#0f172a;color:#fff;border-radius:10px;padding:10px 18px;font-weight:700;cursor:pointer;">Zapisz</button></div>
      </div>`;
    document.body.appendChild(modal);

    document.getElementById('closeEditTaskModal').onclick = () => modal.remove();
    document.getElementById('cancelEditTaskModal').onclick = () => modal.remove();
    document.getElementById('editTaskProgress').oninput = event => {
      document.getElementById('editTaskProgressValue').textContent = event.target.value + '%';
    };
    document.getElementById('saveEditTaskModal').onclick = () => {
      const start = document.getElementById('editTaskStart').value.trim();
      const end = document.getElementById('editTaskEnd').value.trim();
      const nextProgress = document.getElementById('editTaskProgress').value;
      if (!start || !end || start >= end) {
        alert('Wprowadź poprawny zakres godzin.');
        return;
      }
      google.script.run
        .withSuccessHandler(res => {
          if (res && res.success) {
            modal.remove();
            onTargetOrDateChange();
          } else alert('Błąd: ' + (res ? res.message : 'Brak odpowiedzi serwera'));
        })
        .withFailureHandler(err => alert('Błąd połączenia: ' + err))
        .updateWorkReportTask(task.dbRowIndex, {
          start,
          end,
          progress: nextProgress,
          taskId: task.taskId,
          taskName: task.taskName,
          deck: task.deck,
          area: task.area,
